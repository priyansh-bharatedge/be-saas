generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CRM
  HRMS
  Support
  Admin
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  JUNK
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentType {
  FIRST_PAYMENT
  REMAINING_PAYMENT
}

enum PaymentVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum LegalStatus {
  PENDING
  UNDER_REVIEW
  IN_PROGRESS
  DRAFTED
  SENT
  RECEIVED
  EXECUTED
  REJECTED
}

enum OperationStage {
  OPERATION
  QUALITY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ON_LEAVE
  ABSENT
}

enum TrackerStatus {
  ACTIVE
  IDLE
  CLOCKED_OUT
  MEETING_MODE
}

enum LeaveType {
  PAID_LEAVE
  SHORT_LEAVE
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
}

enum RegularizationType {
  MISSED_PUNCH
  LATE_COMING
  EARLY_GOING
  CLIENT_VISIT
}

enum HrmsWorkflowModule {
  LEAVE
  ATTENDANCE_REGULARIZATION
  PERFORMANCE
  RESIGNATION
  REIMBURSEMENT
  HELPDESK
  PAYROLL
  SURVEY
  ONBOARDING_EXIT
}

enum WorkflowTriggerAction {
  ON_CREATE
  ON_UPDATE
  ON_APPROVAL
  ON_REJECTION
}

enum ReimbursementCategory {
  TRAVEL
  CLIENT_MEETING
  FOOD
  INTERNET
  OFFICE_SUPPLIES
  OTHER
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ResignationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum LifecycleType {
  ONBOARDING
  EXIT
}

enum AppraisalStatus {
  UPCOMING
  DUE
  IN_REVIEW
  COMPLETED
}

enum PayrollPaymentStatus {
  PENDING
  PROCESSED
  PAID
}

enum HelpdeskCategory {
  HR_INQUIRY
  IT_HARDWARE
  IT_SOFTWARE
  ACCOUNTS_PAYROLL
  ADMIN_FACILITIES
  LEGAL_COMPLIANCE
  OPERATIONS_ACCESS
  OTHER
}

enum HelpdeskStatus {
  OPEN
  IN_PROGRESS
  APPROVED
  RESOLVED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CalendarEventType {
  HOLIDAY
  EVENT
  IMPORTANT
}

enum PolicyStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum NotificationType {
  INFO
  ACTION_REQUIRED
  SUCCESS
  WARNING
}

enum Language {
  Hindi
  English
  Gujarati
}

enum SystemRole {
  TEAM_MEMBER
  TEAM_LEADER
  ADMIN_HOD
  HR_ADMIN
  SUPER_ADMIN
}

enum SalaryEntity {
  BSPL
  BSAPL
}

enum EmployeeStatus {
  ACTIVE
  ONBOARDING
  ON_LEAVE
  TERMINATED
}

// ==========================================
// CRM MODULES
// ==========================================

model Company {
  id               String    @id @default(uuid())
  name             String
  industry         String?
  companyType      String?
  incorporatedDate DateTime? @db.Date
  website          String?
  gstNumber        String?
  panNumber        String?
  address          String?
  city             String?
  state            String?
  country          String    @default("India")

  createdById      String?
  createdBy        Employee? @relation("CreatedCompanies", fields: [createdById], references: [id], onDelete: SetNull)

  clients Client[]
  deals   Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdById])
  @@map("companies")
}

model Client {
  id                 String    @id @default(uuid())
  clientNumber       String    @unique
  name               String
  phone              String    @unique
  alternatePhone     String?
  email              String?
  gender             String?
  companyName        String?
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  gstNumber          String?
  panNumber          String?
  address            String?
  city               String?
  state              String?
  country            String    @default("India")
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation("AssignedClients", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          Employee? @relation("CreatedClients", fields: [createdById], references: [id], onDelete: SetNull)

  deals      Deal[]
  quotations Quotation[]
  payments   PaymentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@index([companyId])
  @@index([assignedEmployeeId])
  @@index([createdById])
  @@map("clients")
}

model Lead {
  id                 String     @id @default(uuid())
  leadNumber         String     @unique
  name               String
  email              String?
  phone              String
  companyName        String?
  source             String     @default("WEBSITE")
  status             LeadStatus @default(NEW)
  notes              String?    @db.Text
  estimatedBudget    Decimal?   @db.Decimal(12, 2)
  assignedEmployeeId String?
  assignedEmployee   Employee?  @relation("AssignedLeads", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          Employee?  @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([assignedEmployeeId])
  @@index([createdById])
  @@map("leads")
}

model Service {
  id             String   @id @default(uuid())
  name           String   @unique
  code           String?  @unique
  description    String?  @db.Text
  category       String?
  minimumPrice   Decimal  @db.Decimal(12, 2)
  outsourcePrice Decimal  @default(0) @db.Decimal(12, 2)
  sacCode        String?
  defaultGstRate Float    @default(18.0)
  isActive       Boolean  @default(true)

  dealServices       DealService[]
  quotationServices  QuotationService[]
  internalOperations InternalOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("services")
}

model ProspectTab {
  id           String          @id @default(uuid())
  name         String
  teamLeaderId String?
  teamLeader   Employee?       @relation("TLProspectTabs", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  order        Int             @default(0)
  isActive     Boolean         @default(true)

  sheets  ProspectSheet[]
  columns ProspectColumn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamLeaderId])
  @@map("prospect_tabs")
}

model ProspectSheet {
  id            String          @id @default(uuid())
  tabId         String
  tab           ProspectTab     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  name          String
  assignedBdmId String?
  assignedBdm   Employee?       @relation("BDMProspectSheets", fields: [assignedBdmId], references: [id], onDelete: SetNull)
  order         Int             @default(0)

  rows    ProspectRow[]
  columns ProspectColumn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tabId])
  @@index([assignedBdmId])
  @@map("prospect_sheets")
}

model ProspectColumn {
  id         String         @id @default(uuid())
  tabId      String?
  tab        ProspectTab?   @relation(fields: [tabId], references: [id], onDelete: Cascade)
  sheetId    String?
  sheet      ProspectSheet? @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name       String
  key        String
  type       String         @default("TEXT")
  options    Json?
  order      Int            @default(0)
  isRequired Boolean        @default(false)
  isSystem   Boolean        @default(false)
  width      Int            @default(160)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tabId])
  @@index([sheetId])
  @@map("prospect_columns")
}

model ProspectRow {
  id            String        @id @default(uuid())
  sheetId       String
  sheet         ProspectSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  rowIndex      Int           @default(0)
  data          Json
  assignedBdmId String?
  assignedBdm   Employee?     @relation("BDMProspectRows", fields: [assignedBdmId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sheetId])
  @@index([assignedBdmId])
  @@map("prospect_rows")
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientAlternatePhone String?
  clientGender    String?
  clientState     String?
  clientCity      String?
  clientAddress   String?

  companyId       String?
  companyName     String?
  companyType     String?
  companyIncorporatedDate DateTime? @db.Date
  companyAddress  String?

  dealId          String?
  deal            Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  subTotal        Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  gstRate         Float           @default(18.0)
  gstAmount       Decimal         @db.Decimal(12, 2)
  grandTotal      Decimal         @db.Decimal(12, 2)
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?       @db.Date
  terms           String?         @db.Text
  notes           String?         @db.Text
  pdfUrl          String?
  pdfKey          String?
  emailSentAt     DateTime?
  preparedById    String?
  preparedBy      Employee?       @relation("PreparedQuotations", fields: [preparedById], references: [id], onDelete: SetNull)

  services QuotationService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([dealId])
  @@index([status])
  @@index([preparedById])
  @@map("quotations")
}

model QuotationService {
  id               String    @id @default(uuid())
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName      String
  description      String?
  unitPrice        Decimal   @default(0) @db.Decimal(12, 2)
  quantity         Int       @default(1)
  totalAmount      Decimal   @default(0) @db.Decimal(12, 2)
  gstRate          Float     @default(18.0)
  gstAmount        Decimal   @default(0) @db.Decimal(12, 2)
  withoutGstAmount Decimal   @default(0) @db.Decimal(12, 2)
  totalPrice       Decimal   @default(0) @db.Decimal(12, 2)
  remarks          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([serviceId])
  @@map("quotation_services")
}

model PaymentRecord {
  id             String                    @id @default(uuid())
  receiptNumber  String                    @unique
  clientId       String
  client         Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?                     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  amount         Decimal                   @db.Decimal(12, 2)
  bankType       SalaryEntity              @default(BSPL)
  paymentType    PaymentType               @default(FIRST_PAYMENT)
  status         PaymentVerificationStatus @default(UNVERIFIED)
  paymentMode    String                    @default("BANK_TRANSFER")
  transactionRef String?
  screenshotUrl  String?
  screenshotKey  String?
  screenshotUrls String[]                  @default([])
  aiVerificationStatus AiVerificationStatus @default(PENDING)
  aiDetectedAmount     Decimal?             @db.Decimal(12, 2)
  aiAuditSummary       String?              @db.Text
  aiAuditedAt          DateTime?
  paymentDate    DateTime                  @default(now()) @db.Date
  remarks        String?                   @db.Text
  isConvertedToDeal Boolean                  @default(false)
  verifiedById   String?
  verifiedBy     Employee?                 @relation("VerifiedPayments", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  recordedById   String?
  recordedBy     Employee?                 @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([dealId])
  @@index([status])
  @@index([bankType])
  @@index([paymentType])
  @@index([recordedById])
  @@index([verifiedById])
  @@map("payment_records")
}

model Deal {
  id                String    @id @default(uuid())
  dealNumber        String?   @unique
  title             String
  value             Decimal   @db.Decimal(12, 2)
  currency          String    @default("INR")
  stage             DealStage @default(LEAD)
  probability       Float     @default(0.1)
  expectedCloseDate DateTime?
  companyName       String
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  notes             String?

  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  subTotal          Decimal?  @default(0) @db.Decimal(12, 2)
  gstRate           Float?    @default(18.0)
  gstAmount         Decimal?  @default(0) @db.Decimal(12, 2)
  totalValue        Decimal?  @db.Decimal(12, 2)
  amountReceived    Decimal   @default(0) @db.Decimal(12, 2)
  amountPending     Decimal   @default(0) @db.Decimal(12, 2)

  bookingDate       DateTime? @default(now()) @db.Date
  panNumber         String?
  partnerBdmId      String?
  partnerBdm        Employee? @relation("PartnerDeals", fields: [partnerBdmId], references: [id], onDelete: SetNull)
  accountsStatus    String    @default("DRAFT")
  accountsVerifiedAt DateTime?
  paymentScreenshotUrl String?
  paymentScreenshotKey String?

  teamType          String?
  internalLegalStatus LegalStatus @default(PENDING)
  legalDocType      String?
  agreementTerms    String?   @db.Text
  legalRemarks      String?   @db.Text
  legalDocSenderName   String?
  legalDocSenderDate   DateTime? @db.Date
  legalDocReceiverName String?
  legalDocReceiverDate DateTime? @db.Date
  isQualityPassed      Boolean   @default(false)
  qualityRemarks       String?   @db.Text

  assignedEmployeeId String?   @map("assignedUserId")
  assignedEmployee   Employee? @relation("AssignedDeals", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  services           DealService[]
  documents          DealDocument[]
  internalOperations InternalOperation[]
  quotations         Quotation[]
  payments           PaymentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([assignedEmployeeId])
  @@index([clientId])
  @@index([companyId])
  @@map("deals")
}

model DealService {
  id             String   @id @default(uuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName    String
  unitPrice          Decimal  @db.Decimal(12, 2)
  quantity           Int      @default(1)
  gstRate            Float    @default(18.0)
  gstAmount          Decimal  @db.Decimal(12, 2)
  withoutGstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice         Decimal  @db.Decimal(12, 2)
  amountReceived     Decimal  @default(0) @db.Decimal(12, 2)
  receivedGst        Decimal  @default(0) @db.Decimal(12, 2)
  receivedWithoutGst Decimal  @default(0) @db.Decimal(12, 2)
  amountPending      Decimal  @default(0) @db.Decimal(12, 2)
  teamType           String?
  legalStatus        LegalStatus @default(PENDING)
  legalDocType       String?
  agreementTerms     String?     @db.Text
  legalRemarks       String?     @db.Text
  minimumPrice       Decimal  @default(0) @db.Decimal(12, 2)
  outsourceCost      Decimal  @default(0) @db.Decimal(12, 2)
  remarks            String?

  internalOperation InternalOperation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([serviceId])
  @@map("deal_services")
}

model DealDocument {
  id           String    @id @default(uuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title        String
  docType      String    @default("OTHER")
  fileUrl      String
  fileKey      String
  fileSize     Int?
  mimeType     String?
  uploadedById String?
  uploadedBy   Employee? @relation("UploadedDealDocs", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([uploadedById])
  @@map("deal_documents")
}

model InternalOperation {
  id              String         @id @default(uuid())
  operationNumber String         @unique
  dealId          String
  deal            Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealServiceId   String?        @unique
  dealService     DealService?   @relation(fields: [dealServiceId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName     String
  teamType        String
  stage           OperationStage @default(OPERATION)
  internalStage   String         @default("Doc Collection")
  status          String         @default("IN_PROGRESS")
  assignedTlId    String?
  assignedTl      Employee?      @relation("AssignedTlOperations", fields: [assignedTlId], references: [id], onDelete: SetNull)
  assignedTmId    String?
  assignedTm      Employee?      @relation("AssignedTmOperations", fields: [assignedTmId], references: [id], onDelete: SetNull)
  caCs1Id         String?
  caCs1           Employee?      @relation("AssignedCaCs1Operations", fields: [caCs1Id], references: [id], onDelete: SetNull)
  caCs2Id         String?
  caCs2           Employee?      @relation("AssignedCaCs2Operations", fields: [caCs2Id], references: [id], onDelete: SetNull)
  assignedEmployeeIds String[]   @default([])
  workflowData    Json?
  qualityScore    Int?
  qualityFeedback String?        @db.Text
  dueDate         DateTime?      @db.Date
  completionDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([dealServiceId])
  @@index([serviceId])
  @@index([assignedTlId])
  @@index([assignedTmId])
  @@index([caCs1Id])
  @@index([caCs2Id])
  @@index([stage])
  @@map("internal_operations")
}

model SalesTarget {
  id                 String    @id @default(uuid())
  bdmId              String
  bdm                Employee  @relation("BdmSalesTargets", fields: [bdmId], references: [id], onDelete: Cascade)
  setById            String?
  setBy              Employee? @relation("HodSalesTargetsSet", fields: [setById], references: [id], onDelete: SetNull)
  month              Int
  year               Int
  targetAmount       Decimal   @db.Decimal(12, 2)
  targetDealsCount   Int?      @default(0)
  achievedAmount     Decimal   @default(0) @db.Decimal(12, 2)
  achievedDealsCount Int       @default(0)
  remarks            String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bdmId, month, year])
  @@index([bdmId])
  @@index([setById])
  @@index([month, year])
  @@map("sales_targets")
}

// ==========================================
// SUPPORT MODULES
// ==========================================

model Ticket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  source       String         @default("WEBSITE")

  customerName  String
  customerEmail String
  customerPhone String?

  assignedEmployeeId String?   @map("assignedUserId")
  assignedEmployee   Employee? @relation("AssignedTickets", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  auditLogs  AuditLog[]
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model AuditLog {
  id               String   @id @default(uuid())
  ticketId         String
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  auditorId        String
  auditor          Employee @relation("AuditedBy", fields: [auditorId], references: [id], onDelete: Cascade)
  qualityScore     Int
  complianceStatus String
  feedbackComments String
  escalatedToHOD   Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([ticketId])
  @@index([auditorId])
  @@map("audit_logs")
}

// ==========================================
// HRMS MODULES & UNIFIED EMPLOYEE
// ==========================================

model Attendance {
  id               String              @id @default(uuid())
  employeeId       String
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime            @db.Date
  clockInTime      DateTime?
  clockOutTime     DateTime?
  totalActiveHours Float               @default(0)
  currentStatus    TrackerStatus       @default(CLOCKED_OUT)
  sessions         AttendanceSession[]
  regularizations  AttendanceRegularization[] @relation("AttendanceRegularizations")
  locationCoordinates String?
  ipAddress           String?
  remarks             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([currentStatus])
  @@map("attendance_records")
}

model AttendanceSession {
  id              String        @id @default(uuid())
  attendanceId    String
  attendance      Attendance    @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  status          TrackerStatus @default(ACTIVE)
  durationMinutes Float?
  createdAt       DateTime      @default(now())

  @@index([attendanceId])
  @@index([status])
  @@map("attendance_sessions")
}

model Employee {
  id String @id @default(uuid())

  // Authentication & Access Credentials (Consolidated Unified Model)
  passwordHash      String?
  isPasswordSet     Boolean   @default(false)
  encryptedPassword String?   @db.Text
  otp               String?
  otpExpiry         DateTime?
  otpAttempts       Int       @default(0)
  role         Role      @default(HRMS)
  phone        String?
  avatarUrl    String?
  jobTitle     String?

  // Personal Details
  firstName        String
  middleName       String?
  lastName         String
  dateOfBirth      DateTime  @db.Date
  gender           String
  nationality      String    @default("Indian")
  maritalStatus    String    @default("Single")
  contactNumber    String
  personalEmail    String
  permanentAddress String
  currentAddress   String

  // Education & Skills
  educationQualification     String
  professionalCertifications String?
  keySkills                  String?
  languagesKnown             Language[]

  // Emergency & Family Details
  emergencyFirstName    String
  emergencyLastName     String
  emergencyNumber       String
  emergencyRelationship String

  // Department & Access Hierarchy
  employeeId       String      @unique
  dateOfJoining    DateTime    @db.Date
  department       String
  designation      String
  workEmail        String      @unique
  employmentType   String      @default("Full-Time")
  previousEmployer String?
  totalExperience  String?
  branch           String      @default("Headquarters - Ahmedabad")
  systemRole       SystemRole  @default(TEAM_MEMBER)
  monthlyTarget    Decimal?    @db.Decimal(12, 2)

  // Self-Relations for Hierarchy
  teamLeaderId String?
  teamLeader   Employee?  @relation("TeamLeaderRelation", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  teamMembers  Employee[] @relation("TeamLeaderRelation")

  reportingManagerId String?
  reportingManager   Employee?  @relation("ManagerRelation", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates       Employee[] @relation("ManagerRelation")

  // Attendance Records
  attendances Attendance[]

  // Leave Management Relations
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[] @relation("EmployeeLeaveRequests")
  tlLeaveReviews  LeaveRequest[] @relation("TLLeaveReviews")
  hrLeaveReviews  LeaveRequest[] @relation("HRLeaveReviews")
  leaveAdjustments LeaveAdjustmentLog[] @relation("EmployeeLeaveAdjustments")
  adjustedLeaves   LeaveAdjustmentLog[] @relation("AdjustedLeaveLogs")

  // Attendance Regularization Relations
  attendanceRegularizations AttendanceRegularization[] @relation("EmployeeRegularizations")
  reviewedRegularizations   AttendanceRegularization[] @relation("ReviewedRegularizations")

  // HRMS Workflow Engine Relations
  createdWorkflows       HrmsWorkflow[]     @relation("CreatedWorkflows")
  assignedWorkflowSteps  HrmsWorkflowStep[] @relation("AssignedWorkflowSteps")
  actorWorkflowLogs      HrmsWorkflowLog[]  @relation("ActorWorkflowLogs")

  // Reimbursements
  reimbursements         Reimbursement[]    @relation("EmployeeReimbursements")
  approvedReimbursements Reimbursement[]    @relation("ApprovedReimbursements")

  // Resignation & Exit Process
  resignation            Resignation?       @relation("EmployeeResignation")
  reviewedResignations   Resignation[]      @relation("ReviewedResignations")

  // Lifecycle Checklists
  checklists             EmployeeChecklist[]
  assignedChecklistTasks ChecklistItem[]

  // Performance & Appraisals
  appraisals             PerformanceAppraisal[] @relation("EmployeeAppraisals")
  managedAppraisals      PerformanceAppraisal[] @relation("ManagerAppraisals")

  // Payroll
  payrolls               PayrollRecord[]    @relation("EmployeePayrolls")

  // Helpdesk
  helpdeskTickets        HrmsHelpdesk[]     @relation("EmployeeHelpdeskTickets")
  assignedHelpdeskTickets HrmsHelpdesk[]    @relation("AssignedHelpdeskTickets")
  helpdeskComments       HelpdeskComment[]

  // Surveys
  createdSurveys         HrmsSurvey[]
  surveyResponses        HrmsSurveyResponse[]

  // Enterprise Modules Assigned Relations
  assignedDeals   Deal[]         @relation("AssignedDeals")
  partnerDeals    Deal[]         @relation("PartnerDeals")
  assignedTickets Ticket[]       @relation("AssignedTickets")
  auditedLogs     AuditLog[]     @relation("AuditedBy")
  notifications   Notification[]

  // Team Chat Relations
  createdConversations ChatConversation[] @relation("CreatedConversations")
  chatParticipants     ChatParticipant[]  @relation("EmployeeChatParticipants")
  sentChatMessages     ChatMessage[]      @relation("SentChatMessages")
  chatReactions        ChatMessageReaction[] @relation("EmployeeChatReactions")

  // Real-time Online & Last Seen Presence Tracking
  isOnline     Boolean   @default(false)
  lastSeen     DateTime?
  lastActiveAt DateTime?

  // CRM Module Relations
  createdCompanies      Company[]           @relation("CreatedCompanies")
  createdClients        Client[]            @relation("CreatedClients")
  createdLeads          Lead[]              @relation("CreatedLeads")
  assignedLeads         Lead[]              @relation("AssignedLeads")
  assignedClients       Client[]            @relation("AssignedClients")
  tlProspectTabs        ProspectTab[]       @relation("TLProspectTabs")
  bdmProspectSheets     ProspectSheet[]     @relation("BDMProspectSheets")
  bdmProspectRows       ProspectRow[]       @relation("BDMProspectRows")
  preparedQuotations    Quotation[]         @relation("PreparedQuotations")
  verifiedPayments      PaymentRecord[]     @relation("VerifiedPayments")
  recordedPayments      PaymentRecord[]     @relation("RecordedPayments")
  uploadedDealDocs      DealDocument[]      @relation("UploadedDealDocs")
  assignedTlOperations    InternalOperation[] @relation("AssignedTlOperations")
  assignedTmOperations    InternalOperation[] @relation("AssignedTmOperations")
  assignedCaCs1Operations InternalOperation[] @relation("AssignedCaCs1Operations")
  assignedCaCs2Operations InternalOperation[] @relation("AssignedCaCs2Operations")
  salesTargets          SalesTarget[]       @relation("BdmSalesTargets")
  salesTargetsSet       SalesTarget[]       @relation("HodSalesTargetsSet")

  // Bank & Statutory Details
  bankAccountNumber      String
  bankName               String
  ifscCode               String
  panNumber              String
  aadhaarNumber          String
  passportNumber         String?
  drivingLicenseNumber   String?
  salaryEntity           SalaryEntity @default(BSPL)
  pfApplicable           Boolean      @default(true)
  esicNumber             String?
  uanNumber              String?
  medicalInsuranceNumber String?

  // Documents (File Uploads / URLs / Stored Reference Keys)
  passbookChequeUrl        String?
  secondaryEduProofUrl     String?
  graduationMarkSheetsUrl  String?
  offerRelievingLettersUrl String?
  panCardCopyUrl           String?
  addressAgeProofUrl       String?
  bankStatementUrl         String?
  salarySlipsUrl           String?
  passportPhotoUrl         String?

  status    EmployeeStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([workEmail])
  @@index([role])
  @@index([department])
  @@index([systemRole])
  @@index([status])
  @@map("employees")
}

model LeaveBalance {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType
  year           Int       @default(2026)
  allocatedDays  Float     @default(12)
  usedDays       Float     @default(0)
  remainingDays  Float     @default(12)

  // Dynamic Accrual & Short Leave Quota (max 2 leaves/mo, max 3.0 hrs/mo)
  accruedDays         Float    @default(0)
  monthlyShortLeaves  Int      @default(0)
  monthlyShortHours   Float    @default(0)

  // HR Admin manual balance adjustment audit
  lastAdjustedAt      DateTime?
  lastAdjustedById    String?
  lastAdjustmentReason String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveAdjustmentLog {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation("EmployeeLeaveAdjustments", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType
  previousBalance  Float
  newBalance       Float
  adjustmentAmount Float
  unit             String    @default("DAYS") // "DAYS" or "HOURS"
  reason           String
  adjustedById     String
  adjustedBy       Employee  @relation("AdjustedLeaveLogs", fields: [adjustedById], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([employeeId])
  @@index([adjustedById])
  @@map("leave_adjustment_logs")
}

model LeaveRequest {
  id           String         @id @default(uuid())
  employeeId   String
  employee     Employee       @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  totalDays    Float

  // Short Leave specific fields (max 1.5 hrs/request, max 3.0 hrs/mo, max 2 requests/mo)
  startTime     String?
  endTime       String?
  durationHours Float?

  reason       String

  // 2-Tier Approval Flow: TL -> HR Admin -> Final Status
  teamLeaderId String?
  teamLeader   Employee?      @relation("TLLeaveReviews", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  tlStatus     ApprovalStatus @default(PENDING)
  tlComments   String?
  tlReviewedAt DateTime?

  hrAdminId    String?
  hrAdmin      Employee?      @relation("HRLeaveReviews", fields: [hrAdminId], references: [id], onDelete: SetNull)
  hrStatus     ApprovalStatus @default(PENDING)
  hrComments   String?
  hrReviewedAt DateTime?

  finalStatus  ApprovalStatus @default(PENDING)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([employeeId])
  @@index([teamLeaderId])
  @@index([hrAdminId])
  @@index([finalStatus])
  @@map("leave_requests")
}

model AttendanceRegularization {
  id                 String             @id @default(uuid())
  employeeId         String
  employee           Employee           @relation("EmployeeRegularizations", fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceId       String?
  attendance         Attendance?        @relation("AttendanceRegularizations", fields: [attendanceId], references: [id], onDelete: SetNull)
  date               DateTime           @db.Date
  requestedClockIn   DateTime
  requestedClockOut  DateTime
  regularizationType RegularizationType
  reason             String
  attachmentUrl      String?
  status             ApprovalStatus     @default(PENDING)
  reviewedById       String?
  reviewedBy         Employee?          @relation("ReviewedRegularizations", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewRemarks      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([employeeId])
  @@index([attendanceId])
  @@index([status])
  @@index([date])
  @@map("attendance_regularizations")
}

model HrmsWorkflow {
  id                   String                 @id @default(uuid())
  name                 String
  description          String?
  module               HrmsWorkflowModule
  triggerAction        WorkflowTriggerAction  @default(ON_CREATE)
  departmentScope      String                 @default("ALL") // "ALL" or specific department
  isActive             Boolean                @default(true)
  intimationRecipients Json                   @default("[]") // ["REPORTING_TL", "DEPT_HOD", "HR_ADMIN"] or specific employee IDs
  approvers            Json                   @default("[]") // [{"step": 1, "role": "REPORTING_TL"}, {"step": 2, "role": "HR_ADMIN"}]
  conditions           Json?
  createdById          String?
  createdBy            Employee?              @relation("CreatedWorkflows", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  steps                HrmsWorkflowStep[]
  executionLogs        HrmsWorkflowLog[]

  @@index([module])
  @@index([isActive])
  @@index([departmentScope])
  @@map("hrms_workflows")
}

model HrmsWorkflowStep {
  id           String       @id @default(uuid())
  workflowId   String
  workflow     HrmsWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder    Int          @default(1)
  stepName     String
  approverRole String       // "REPORTING_TL", "DEPT_HOD", "HR_ADMIN", "SPECIFIC_EMPLOYEE"
  approverId   String?
  approver     Employee?    @relation("AssignedWorkflowSteps", fields: [approverId], references: [id], onDelete: SetNull)
  isMandatory  Boolean      @default(true)
  timeoutHours Int?         @default(48)
  createdAt    DateTime     @default(now())

  @@index([workflowId])
  @@map("hrms_workflow_steps")
}

model HrmsWorkflowLog {
  id          String             @id @default(uuid())
  workflowId  String
  workflow    HrmsWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  recordId    String
  module      HrmsWorkflowModule
  action      String             // "INTIMATION_SENT", "APPROVAL_REQUESTED", "APPROVED", "REJECTED"
  actorId     String?
  actor       Employee?          @relation("ActorWorkflowLogs", fields: [actorId], references: [id], onDelete: SetNull)
  recipientId String?
  details     String?
  createdAt   DateTime           @default(now())

  @@index([workflowId])
  @@index([recordId])
  @@map("hrms_workflow_logs")
}

model Reimbursement {
  id            String                @id @default(uuid())
  employeeId    String
  employee      Employee              @relation("EmployeeReimbursements", fields: [employeeId], references: [id], onDelete: Cascade)
  title         String
  category      ReimbursementCategory
  expenseDate   DateTime              @db.Date
  amount        Float
  description   String
  receiptUrls   Json                  @default("[]") // Array of Cloudflare R2 file URLs
  status        ReimbursementStatus   @default(PENDING)
  approvedById  String?
  approvedBy    Employee?             @relation("ApprovedReimbursements", fields: [approvedById], references: [id], onDelete: SetNull)
  paidAt        DateTime?
  remarks       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([expenseDate])
  @@map("reimbursements")
}

model Resignation {
  id                     String            @id @default(uuid())
  employeeId             String            @unique
  employee               Employee          @relation("EmployeeResignation", fields: [employeeId], references: [id], onDelete: Cascade)
  resignationDate        DateTime          @db.Date
  proposedLastWorkingDay DateTime          @db.Date
  actualLastWorkingDay   DateTime?         @db.Date
  reason                 String
  comments               String?
  status                 ResignationStatus @default(PENDING)
  reviewerId             String?
  reviewer               Employee?         @relation("ReviewedResignations", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerRemarks        String?
  reviewedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status])
  @@map("resignations")
}

model EmployeeChecklist {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            LifecycleType
  title           String
  progressPercent Float           @default(0)
  isCompleted     Boolean         @default(false)
  tasks           ChecklistItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId])
  @@index([type])
  @@map("employee_checklists")
}

model ChecklistItem {
  id          String            @id @default(uuid())
  checklistId String
  checklist   EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  category    String            @default("GENERAL") // e.g. "KYC", "IT_SETUP", "POLICY", "ASSET_RETURN"
  isCompleted Boolean           @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  assigneeId  String?
  assignee    Employee?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([checklistId])
  @@map("checklist_items")
}

model PerformanceAppraisal {
  id             String          @id @default(uuid())
  employeeId     String
  employee       Employee        @relation("EmployeeAppraisals", fields: [employeeId], references: [id], onDelete: Cascade)
  appraisalCycle String          // e.g. "Q4 2026", "Annual 2026"
  dueDate        DateTime        @db.Date
  selfReview     String?
  managerRating  Float?          // 1.0 to 5.0
  managerReview  String?
  managerId      String?
  manager        Employee?       @relation("ManagerAppraisals", fields: [managerId], references: [id], onDelete: SetNull)
  hrRemarks      String?
  status         AppraisalStatus @default(UPCOMING)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
  @@map("performance_appraisals")
}

model PayrollRecord {
  id                  String               @id @default(uuid())
  employeeId          String
  employee            Employee             @relation("EmployeePayrolls", fields: [employeeId], references: [id], onDelete: Cascade)
  month               Int                  // 1 - 12
  year                Int                  // e.g. 2026
  baseSalary          Float
  deductions          Float                @default(0)
  reimbursementsAdded Float                @default(0)
  netPayable          Float
  paymentStatus       PayrollPaymentStatus @default(PENDING)
  paidAt              DateTime?
  payslipUrl          String?
  remarks             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([paymentStatus])
  @@index([month, year])
  @@map("payroll_records")
}

model HrmsHelpdesk {
  id               String            @id @default(uuid())
  ticketNumber     String            @unique
  employeeId       String
  employee         Employee          @relation("EmployeeHelpdeskTickets", fields: [employeeId], references: [id], onDelete: Cascade)
  targetDepartment String            // HR, IT, Account, Admin, Legal, Operation, etc.
  subject          String
  category         HelpdeskCategory  @default(HR_INQUIRY)
  priority         TicketPriority    @default(MEDIUM)
  description      String
  attachments      Json              @default("[]") // R2 URLs
  status           HelpdeskStatus    @default(OPEN)
  assignedToId     String?
  assignedTo       Employee?         @relation("AssignedHelpdeskTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  comments         HelpdeskComment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([employeeId])
  @@index([targetDepartment])
  @@index([status])
  @@map("hrms_helpdesk_tickets")
}

model HelpdeskComment {
  id          String       @id @default(uuid())
  ticketId    String
  ticket      HrmsHelpdesk @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      Employee     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  message     String
  attachments Json         @default("[]")
  createdAt   DateTime     @default(now())

  @@index([ticketId])
  @@map("helpdesk_comments")
}

model HrmsSurvey {
  id               String               @id @default(uuid())
  title            String
  description      String?
  questions        Json                 @default("[]")
  targetDepartment String               @default("ALL")
  startDate        DateTime             @db.Date
  endDate          DateTime             @db.Date
  isActive         Boolean              @default(true)
  createdById      String?
  createdBy        Employee?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  responses        HrmsSurveyResponse[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([isActive])
  @@map("hrms_surveys")
}

model HrmsSurveyResponse {
  id          String     @id @default(uuid())
  surveyId    String
  survey      HrmsSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  answers     Json       @default("{}")
  submittedAt DateTime   @default(now())

  @@unique([surveyId, employeeId])
  @@index([surveyId])
  @@index([employeeId])
  @@map("hrms_survey_responses")
}

model CalendarEvent {
  id          String            @id @default(uuid())
  title       String
  date        DateTime          @db.Date
  type        CalendarEventType @default(EVENT)
  startTime   String?
  endTime     String?
  description String?
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([type])
  @@map("calendar_events")
}

model CompanyPolicy {
  id            String       @id @default(uuid())
  title         String
  category      String
  content       String       @db.Text
  documentUrl   String?
  effectiveDate DateTime     @db.Date
  status        PolicyStatus @default(PUBLISHED)
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category])
  @@index([status])
  @@map("company_policies")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  employee    Employee         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([recipientId])
  @@index([isRead])
  @@map("notifications")
}

// ==========================================
// TEAM CHAT MODULE (INTERNAL MESSAGING)
// ==========================================

enum ChatParticipantRole {
  ADMIN
  MEMBER
}

enum AiVerificationStatus {
  PENDING
  MATCHED
  MISMATCH
  UNREADABLE
}

enum ChatMessageType {
  TEXT
  IMAGE
  DOCUMENT
  FILE
  AI_REPORT
  AI_ALERT
}

enum GroupSendMessagePermission {
  ALL_MEMBERS
  ONLY_ADMINS
}

model ChatConversation {
  id                    String                     @id @default(uuid())
  isGroup               Boolean                    @default(false)
  isAiAgent             Boolean                    @default(false)
  name                  String?
  avatarUrl             String?
  createdById           String
  createdBy             Employee                   @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Cascade)
  sendMessagePermission GroupSendMessagePermission @default(ALL_MEMBERS)
  
  participants ChatParticipant[]
  messages     ChatMessage[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([createdById])
  @@map("chat_conversations")
}

model ChatParticipant {
  id              String              @id @default(uuid())
  conversationId  String
  conversation    ChatConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee            @relation("EmployeeChatParticipants", fields: [employeeId], references: [id], onDelete: Cascade)
  role            ChatParticipantRole @default(MEMBER)
  canSendMessages Boolean             @default(true)
  lastReadAt      DateTime?
  joinedAt        DateTime            @default(now())

  @@unique([conversationId, employeeId])
  @@index([employeeId])
  @@index([conversationId])
  @@map("chat_participants")
}

model ChatMessage {
  id                 String           @id @default(uuid())
  conversationId     String
  conversation       ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId           String
  sender             Employee         @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content            String?          @db.Text
  messageType        ChatMessageType  @default(TEXT)
  attachmentUrl      String?
  attachmentName     String?
  attachmentSize     Int?
  attachmentMimeType String?
  attachments        Json?
  metadata           Json?
  isDeleted          Boolean          @default(false)
  reactions          ChatMessageReaction[]

  createdAt          DateTime         @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_messages")
}

model ChatMessageReaction {
  id         String      @id @default(uuid())
  messageId  String
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation("EmployeeChatReactions", fields: [employeeId], references: [id], onDelete: Cascade)
  emoji      String
  createdAt  DateTime    @default(now())

  @@unique([messageId, employeeId])
  @@index([messageId])
  @@index([employeeId])
  @@map("chat_message_reactions")
}

model AiCronLog {
  id          String   @id @default(uuid())
  scheduleKey String
  date        String
  status      String   @default("SUCCESS")
  details     Json?
  createdAt   DateTime @default(now())

  @@unique([scheduleKey, date])
  @@map("ai_cron_logs")
}



